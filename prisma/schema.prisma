generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedWorkspaces    Workspace[]
  workspaceMembers   WorkspaceMember[]
  createdDocuments   Document[]
  createdBoards      Board[]
  assignedTasks      Task[]
  messages           Message[]
  onboardingAnswers  Json?

  @@map("users")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]
  documents Document[]
  boards    Board[]
  conversations Conversation[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member") // owner, admin, member
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model Document {
  id          String   @id @default(cuid())
  workspaceId String
  title       String   @default("Untitled")
  content     Json     @default("{}")
  type        String   @default("doc") // doc, template
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id])
  conversations Conversation[]

  @@map("documents")
}

model Board {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  columns     Json     @default("[]")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id])
  tasks       Task[]
  conversations Conversation[]

  @@map("boards")
}

model Task {
  id          String    @id @default(cuid())
  boardId     String
  columnId    String
  title       String
  description String?
  assigneeId  String?
  dueDate     DateTime?
  priority    String?   // high, medium, low
  status      String    @default("todo")
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  assignee User?  @relation(fields: [assigneeId], references: [id])

  @@map("tasks")
}

model Conversation {
  id          String   @id @default(cuid())
  workspaceId String
  contextType String   // document, board, general
  contextId   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [contextId], references: [id])
  board     Board?    @relation(fields: [contextId], references: [id])
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@map("messages")
}
